[Unit]
Description=Presto Spotify Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admin/PrestoDeck
ExecStart=/usr/bin/python3 /home/admin/PrestoDeck/pi_bridge/spotify_bridge.py --host 0.0.0.0 --port 8787
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
